# Which QIE network this frontend points at.
NEXT_PUBLIC_QIE_FORGE_NETWORK=testnet
# Optional RPC override (defaults to the real, verified endpoint for the network above).
NEXT_PUBLIC_QIE_FORGE_RPC_URL=

# Deployed contract addresses. Left unset until a real on-chain deployment
# exists (blocked on a funded deployer wallet — see docs/STATUS.md). The UI
# shows an honest "not deployed yet" state when these are empty, rather
# than pointing at a placeholder address.
NEXT_PUBLIC_QIE_FORGE_FACTORY_ADDRESS=
NEXT_PUBLIC_QIE_FORGE_ROUTER_ADDRESS=
NEXT_PUBLIC_QIE_FORGE_VAULT_ADDRESS=
NEXT_PUBLIC_QIE_FORGE_VAULT_COLLATERAL_ADDRESS=
NEXT_PUBLIC_QIE_FORGE_VAULT_COLLATERAL_DECIMALS=18
NEXT_PUBLIC_QIE_FORGE_VAULT_COLLATERAL_SYMBOL=
# The vault's borrow/quote asset — the one borrowers draw down and lenders
# supply via deposit()/withdraw() (see components/LendCard.tsx). Left unset
# until deployed; the borrow/repay and lender-supply UI stay disabled
# without it, same fail-closed posture as every other address here.
NEXT_PUBLIC_QIE_FORGE_VAULT_BORROW_ADDRESS=
NEXT_PUBLIC_QIE_FORGE_VAULT_BORROW_DECIMALS=18
NEXT_PUBLIC_QIE_FORGE_VAULT_BORROW_SYMBOL=

# Comma-separated SYMBOL:address:decimals list for the swap token picker.
NEXT_PUBLIC_QIE_FORGE_SWAP_TOKENS=
