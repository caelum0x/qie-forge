# Required for script/Deploy.s.sol — a real private key with testnet QIE
# for gas (from https://qie.digital/faucet — a wallet-connect flow, not a
# plain API, so this is an owner/operator step, not something automatable
# in CI). NEVER commit a real key.
DEPLOYER_PRIVATE_KEY=

# Optional, defaults to 3600 (1 hour) in Deploy.s.sol.
ORACLE_MAX_STALENESS_SECONDS=3600
